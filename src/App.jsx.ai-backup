            </div>

            <h3 className="case-title">{study.title}</h3>
            <p className="case-description">{study.headline}</p>
            <p className="case-description">{study.description}</p>

            {study.features && study.features.length > 0 && (
              <div className="simple-features">
                {study.features.map((feature) => (
                  <div key={feature} className="feature-item">
                    <span className="marker">•</span>
                    {feature}
                  </div>
                ))}
              </div>
            )}

            {study.featureGrid && (
              <div className="feature-grid">
                {study.featureGrid.map((item) => (
                  <div key={item.label} className="grid-item">
                    <span className="label">{item.label}</span>
                    <span className="value">{item.value}</span>
                  </div>
                ))}
              </div>
            )}

            <div className="simple-card-bottom">
              <div className="stack-tags">
                {study.stack.map((item) => (
                  <span key={item} className="stack-tag">
                    {item}
                  </span>
                ))}
              </div>

              {study.note && (
                <span className="card-status">
                  <Lock size={11} aria-hidden="true" />
                  {study.note}
                </span>
              )}

              {study.liveUrl && (
                <a
                  className="action-link"
                  href={study.liveUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  Live demo
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
              )}

              {study.repoUrl ? (
                <a
                  className="action-link"
                  href={study.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  {study.repoLinkText}
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
              ) : (
                <span className="action-link">
                  {study.repoLinkText}
                  <ArrowUpRight size={14} aria-hidden="true" />
                </span>
              )}
            </div>
          </>
        )}
      </div>
    </motion.article>
  );
}

function CapabilitiesSection() {
  return (
    <section id="capabilities" className="section-shell capabilities">
      <div className="container">
        <SectionHeader
          index={3}
          label="Capabilities"
          title="Systems I Build With"
          description="Full-stack engineering spanning backend architecture, data pipelines, and applied AI."
        />
        <motion.div
          className="capabilities-grid"
          variants={animations.stagger}
          initial="hidden"
          whileInView="visible"
          viewport={viewport}
        >
          {capabilities.map((cap) => (
            <motion.article
              key={cap.title}
              className="capability-card"
              variants={animations.fadeUp}
            >
              <div className="capability-card-header">
                <h3>{cap.title}</h3>
                <IconLookup name={cap.icon} size={20} />
              </div>
              <ul>
                {cap.items.map((item) => {
                  const parts = item.split(":");
                  return (
                    <li key={item}>
                      <span className="marker">▹</span>
                      <span className="text">
                        <strong>{parts[0]}:</strong> {parts[1]?.trim()}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </motion.article>
          ))}
        </motion.div>
      </div>
    </section>
  );
}

