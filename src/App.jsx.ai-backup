import React from "react";
import {
  ArrowUpRight,
  Check,
  Cloud,
  Copy,
  Database,
  Download,
  Eye,
  FileText,
  Filter,
  Github,
  Globe,
  GraduationCap,
  LayoutDashboard,
  Linkedin,
  Lock,
  Mail,
  Moon,
  Plus,
  Rocket,
  Shield,
  Terminal,
  Sun,
  X,
} from "lucide-react";
import {
  motion,
  useScroll,
  useSpring,
  useReducedMotion,
} from "framer-motion";
import { useState, useEffect, useLayoutEffect, useRef, useCallback } from "react";

import {
  about,
  certifications,
  education,
  experience,
  filterCategories,
  footerNote,
  heroBio,
  capabilities,
  navItems,
  pipelineSteps,
  profile,
  quickMetrics,
  systemInfo,
  caseStudies,
} from "./portfolioData.js";

import { animations, reducedAnimations, viewport, interactions } from "./designTokens.js";

const iconMap = {
  cloud_download: Cloud,
  filter_alt: Filter,
  database: Database,
  dashboard: LayoutDashboard,
  terminal: Terminal,
  web: Globe,
  visibility: Eye,
  deployed_code: Rocket,
  verified: Shield,
};

function IconLookup({ name, size = 16, className = "" }) {
  const Icon = iconMap[name];
  if (!Icon) return null;
  return <Icon size={size} className={className} aria-hidden="true" />;
}

function useToast() {
  const [toasts, setToasts] = useState([]);
  const addToast = useCallback((message) => {
    const id = Date.now() + Math.random();
    setToasts((prev) => {
      const updated = [...prev, { id, message }];
      if (updated.length > 3) updated.shift();
      return updated;
    });
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 3500);
  }, []);
  const removeToast = useCallback((id) => {
    setToasts((prev) => prev.filter((t) => t.id !== id));
  }, []);
  return { toasts, addToast, removeToast };
}

function useTheme() {
  const [theme, setTheme] = useState(() => {
    if (typeof window === "undefined") return "light";
    const stored = window.localStorage.getItem("theme");
    return stored === "light" || stored === "dark" ? stored : "light";
  });

  useEffect(() => {
    document.documentElement.dataset.theme = theme;
    window.localStorage.setItem("theme", theme);
  }, [theme]);

  return [theme, () => setTheme((t) => (t === "dark" ? "light" : "dark"))];
}

function Button({ className = "", children, ...rest }) {
  const prefersReducedMotion = useReducedMotion();
  return (
    <motion.a
      className={`btn ${className}`.trim()}
      whileTap={prefersReducedMotion ? undefined : interactions.tap}
      transition={interactions.tapTransition}
      {...rest}
    >
      {children}
    </motion.a>
  );
}

function FadeImage({ src, alt, className = "", eager = false }) {
  const [loaded, setLoaded] = useState(false);
  const imgRef = useRef(null);

  useEffect(() => {
    if (imgRef.current?.complete) setLoaded(true);
  }, []);

  return (
    <img
      ref={imgRef}
      src={src}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      className={`fade-img ${loaded ? "is-loaded" : ""} ${className}`.trim()}
      onLoad={() => setLoaded(true)}
    />
  );
}

function SectionHeader({ index, label, title, description }) {
  return (
    <div className="section-header">
      <div className="label-row">
        <span className="num">{String(index).padStart(2, "0")}</span>
        {label}
      </div>
      <h2>{title}</h2>
      {description && <p className="description">{description}</p>}
    </div>
  );
}

function DiagnosticTicker() {
  return (
    <div className="diagnostic-ticker">
