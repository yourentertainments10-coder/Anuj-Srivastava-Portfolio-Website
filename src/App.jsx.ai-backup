}

function Hero() {
  const prefersReducedMotion = useReducedMotion();
  const anim = prefersReducedMotion ? reducedAnimations : animations;

  return (
    <motion.section
      id="hero"
      className="hero section-shell"
      variants={anim.fadeIn}
      initial="hidden"
      animate="visible"
    >
      <div className="inner">
        <div className="hero-content">
          <span className="hero-label">Systems & Full-Stack Engineering</span>
          <h1 className="hero-title">{profile.name}</h1>
          <p className="hero-quote">{heroBio}</p>

          <div className="quick-metrics">
            {quickMetrics.map((m) => (
              <div key={m.label} className="quick-metric">
                <span className="label">{m.label}</span>
                <span className="value">{m.value}</span>
                <span className="sub">{m.sub}</span>
              </div>
            ))}
          </div>

          <div className="hero-actions">
            <Button
              className="primary"
              href={profile.resumeUrl}
              download
              aria-label="Download resume PDF"
            >
              Resume
            </Button>
            <Button
              href={profile.githubUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="View GitHub profile"
            >
              GitHub
            </Button>
            <Button
              href={`mailto:${profile.email}`}
              aria-label={`Email ${profile.email}`}
            >
              <Mail size={18} aria-hidden="true" /> Email
            </Button>
          </div>
        </div>

        {profile.photo && (
          <motion.div
            className="hero-photo"
            variants={anim.fadeIn}
            initial="hidden"
            animate="visible"
            transition={{ delay: 0.25 }}
          >
            <FadeImage src={profile.photo} alt={profile.photoAlt} eager />
          </motion.div>
        )}
      </div>
    </motion.section>
  );
}

function ArchitecturePanel() {
  return (
    <div className="architecture-panel">
      <div className="architecture-header">
        <div className="dots">
          <span className="dot error" />
          <span className="dot tertiary" />
          <span className="dot outline" />
        </div>
        <span className="title">PIPELINE EXECUTION TRACE</span>
        <span className="status">LIVE</span>
      </div>

      <div className="architecture-body">
        <div className="comment">// ProcureHub — Multi-channel procurement pipeline</div>
        <div className="pipeline">
          {pipelineSteps.map((step, i) => (
            <React.Fragment key={step.label}>
              {i > 0 && (
                <div className="pipeline-arrow">
                  <ArrowUpRight size={12} aria-hidden="true" />
                </div>
              )}
              <div className="pipeline-step">
                <div className="left">
                  <span className="icon">
                    <IconLookup name={step.icon} size={16} />
                  </span>
                  <span className="step-label">{step.label}</span>
                </div>
                <span className="detail primary">{step.detail}</span>
              </div>
            </React.Fragment>
          ))}
        </div>
      </div>

      <div className="architecture-footer">
        <span className="left">ProcureHub — Delhi Ops</span>
        <span className="right">
          → {pipelineSteps.length} stage pipeline
        </span>
      </div>
