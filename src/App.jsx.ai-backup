                          step.status === "200 OK"
                            ? "ok"
                            : step.status === "Processing"
                            ? "warn"
                            : "ok"
                        }`}
                      >
                        {step.status}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="case-content-side">
                <div className="metrics-header">
                  <span className="title">{study.metricsHeader}</span>
                  <span className="badge">{study.metricsBadge}</span>
                </div>
                <div className="metrics-grid">
                  {study.metrics.map((m) => (
                    <div key={m.label} className="metric-card">
                      <div className="label">{m.label}</div>
                      <div className="value primary">{m.value}</div>
                      {m.sub && <div className="note">{m.sub}</div>}
                    </div>
                  ))}
                </div>

                <div className="stack-tags">
                  {study.stack.map((item) => (
                    <span key={item} className="stack-tag">
                      {item}
                    </span>
                  ))}
                </div>

                <div className="card-footer">
                  <span className="info">{study.client}</span>
                  {study.repoUrl && (
                    <a
                      className="repo-link"
                      href={study.repoUrl}
                      target="_blank"
                      rel="noreferrer"
