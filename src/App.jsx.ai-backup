}

function ContactSection({ onToast }) {
  const [copied, setCopied] = useState(false);

  const copyEmail = async () => {
    try {
      await navigator.clipboard.writeText(profile.email);
      setCopied(true);
      onToast("Copied email to clipboard");
      setTimeout(() => setCopied(false), 2000);
    } catch {
      onToast("Could not copy — select manually");
    }
  };

  return (
    <section id="contact" className="contact-section">
      <div className="inner">
        <div className="contact-grid">
          <div className="contact-main">
            <div className="header">
              <div className="label-row">
                <span className="num">06</span>
                AVAILABLE FOR ROLES
              </div>
              <h2>Let's build something useful.</h2>
            </div>

            <div className="contact-message">
              <p>
                {profile.availability}. The fastest way to reach me is email.
              </p>
              <p>
                Open to full-time roles, internships, and collaboration on
                interesting problems.
              </p>
            </div>

            <div className="email-copy">
              <span className="label">EMAIL</span>
              <span className="address">{profile.email}</span>
              <div className="actions">
                <button
                  type="button"
                  className="btn-copy"
                  onClick={copyEmail}
                  aria-label="Copy email address"
                >
                  {copied ? (
                    <Check size={14} aria-hidden="true" />
                  ) : (
                    <Copy size={14} aria-hidden="true" />
                  )}
                  {copied ? "Copied!" : "Copy"}
                </button>
                <a
                  href={`mailto:${profile.email}`}
                  className="btn-send"
                  aria-label="Open email client"
                >
                  <Mail size={14} aria-hidden="true" /> Send
                </a>
              </div>
            </div>
          </div>

          <div className="contact-side">
            <div className="social-grid">
              <span className="social-label">Social</span>
              <a
                className="social-link"
                href={profile.githubUrl}
                target="_blank"
                rel="noreferrer"
              >
                <span className="left">
                  <Github size={16} className="icon" aria-hidden="true" />
                  <span className="text">GitHub</span>
                </span>
                <ArrowUpRight size={14} className="arrow" aria-hidden="true" />
              </a>
              <a
                className="social-link"
                href={profile.linkedinUrl}
                target="_blank"
                rel="noreferrer"
              >
                <span className="left">
                  <Linkedin size={16} className="icon" aria-hidden="true" />
                  <span className="text">LinkedIn</span>
                </span>
                <ArrowUpRight size={14} className="arrow" aria-hidden="true" />
              </a>
              <a
                className="social-link"
                href={profile.resumeUrl}
                download
              >
                <span className="left">
                  <FileText size={16} className="icon" aria-hidden="true" />
                  <span className="text">Resume PDF</span>
                </span>
                <ArrowUpRight size={14} className="arrow" aria-hidden="true" />
              </a>
              <span className="response-time">Usually responds within 24h</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}

function Header({ activeSection, linkRefs, navRef, indicatorStyle, theme, toggleTheme, isScrolled }) {
  const prefersReducedMotion = useReducedMotion();

  const navConfig = navItems.map((item, i) => {
    const lower = item.toLowerCase();
    let href = `#${lower}`;
    if (item === "Work" || item === "Case Studies") href = "#case-studies";
    if (item === "Architecture") href = "#hero";
    return { label: item, href, lower, num: i + 1 };
  });

  return (
    <header className={`site-header ${isScrolled ? "scrolled" : ""}`}>
      <div className="header-inner inner">
        <div className="header-brand">
          <span className="brand-mark">AS</span>
          <span className="brand-path">~/{profile.handle}</span>
          <span className="brand-status">
            <span className="dot" aria-hidden="true" />
            {profile.availability}
          </span>
        </div>

        <nav className="header-nav" aria-label="Primary navigation" ref={navRef}>
          <motion.span
            className="nav-indicator"
            animate={{
              x: indicatorStyle.x,
              y: indicatorStyle.y,
              width: indicatorStyle.width,
              opacity: indicatorStyle.opacity,
            }}
            transition={prefersReducedMotion ? { duration: 0 } : interactions.navIndicator}
            aria-hidden="true"
          />
          {navConfig.map((item) => (
            <a
              key={item.label}
              ref={(el) => {
                linkRefs.current[item.lower] = el;
              }}
              href={item.href}
              className={`nav-link ${activeSection === item.lower ? "active" : ""}`}
              data-num={String(item.num).padStart(2, "0")}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div className="header-social">
          <button
            type="button"
            className="theme-toggle"
            onClick={toggleTheme}
            aria-label={`Switch to ${theme === "dark" ? "light" : "dark"} theme`}
          >
            {theme === "dark" ? <Sun size={17} /> : <Moon size={17} />}
          </button>
          <a
            className="contact-btn"
            href={profile.resumeUrl}
            download
            aria-label="Download resume"
          >
            <Download size={16} />
          </a>
        </div>
      </div>
    </header>
  );
}

function ResumeModal({ isOpen, onClose, onToast }) {
  return (
    <div className={`resume-modal ${isOpen ? "active" : ""}`}>
      <div className="content">
        <div className="modal-header">
          <div className="title">
            <Download size={20} className="icon" aria-hidden="true" />
            <span className="text">Download Resume</span>
          </div>
          <button
            type="button"
            className="close-btn"
            onClick={onClose}
            aria-label="Close"
          >
            <X size={18} />
          </button>
        </div>
        <div className="modal-body">
          <div className="file-info">
            <div className="name">
              {profile.name} — Resume
            </div>
            <div className="meta">PDF · ~120 KB</div>
            <div className="status">Ready for download</div>
          </div>
          <p>
            Download my full resume (PDF) covering work history, projects,
            and certifications.
          </p>
        </div>
        <div className="modal-footer">
          <button type="button" className="btn-dismiss" onClick={onClose}>
            Cancel
          </button>
          <a
            href={profile.resumeUrl}
            download
            className="btn-download"
            onClick={() => {
              onToast("Resume download started");
              onClose();
            }}
          >
            <Download size={12} aria-hidden="true" />
            Download
          </a>
        </div>
      </div>
    </div>
  );
}

function Toast({ toasts }) {
  if (toasts.length === 0) return null;

  return (
    <div className="toast-container" role="status" aria-live="polite">
      {toasts.map((toast) => (
        <motion.div
          key={toast.id}
          className="toast"
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0, y: 10 }}
          transition={{ duration: 0.2 }}
        >
          <Check size={14} className="icon" aria-hidden="true" />
          {toast.message}
        </motion.div>
      ))}
    </div>
  );
}

function App() {
  const [isScrolled, setIsScrolled] = useState(false);
  const [activeSection, setActiveSection] = useState("hero");
  const [showAll, setShowAll] = useState(false);
  const [activeFilter, setActiveFilter] = useState("all");
  const [showResumeModal, setShowResumeModal] = useState(false);
  const [theme, toggleTheme] = useTheme();
  const { toasts, addToast, removeToast } = useToast();

  const navRef = useRef(null);
  const linkRefs = useRef({});
  const [indicatorStyle, setIndicatorStyle] = useState({
    x: 0,
    y: 0,
    width: 0,
    opacity: 0,
  });

  const { scrollYProgress } = useScroll();
  const progressScaleX = useSpring(
    scrollYProgress,
    interactions.scrollProgress
  );

  useEffect(() => {
    const handleScroll = () => setIsScrolled(window.scrollY > 20);
    window.addEventListener("scroll", handleScroll, { passive: true });
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveSection(entry.target.id);
          }
        });
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 }
    );

    document
      .querySelectorAll("section[id]")
      .forEach((section) => observer.observe(section));

    return () => observer.disconnect();
  }, []);

  useLayoutEffect(() => {
    const activeEl = linkRefs.current[activeSection];
    if (!activeEl) {
      setIndicatorStyle((prev) => ({ ...prev, opacity: 0 }));
      return;
    }
    const navRect = navRef.current?.getBoundingClientRect();
    if (!navRect) return;
    const linkRect = activeEl.getBoundingClientRect();
    setIndicatorStyle({
      x: linkRect.left - navRect.left,
      y: linkRect.bottom - navRect.top - 2,
      width: linkRect.width,
      opacity: 1,
    });
  }, [activeSection]);

  const filteredStudies = caseStudies.filter((study) => {
    if (activeFilter === "all") return true;
    return study.category === activeFilter;
  });

  const visibleStudies = showAll
    ? filteredStudies
    : filteredStudies.slice(0, 6);

  return (
    <>
      <motion.div
        className="scroll-progress"
        style={{ scaleX: progressScaleX }}
        aria-hidden="true"
      />

      <a className="skip-link" href="#case-studies">
        Skip to projects
      </a>

      <DiagnosticTicker />

      <Header
        activeSection={activeSection}
        linkRefs={linkRefs}
        navRef={navRef}
        indicatorStyle={indicatorStyle}
        theme={theme}
        toggleTheme={toggleTheme}
        isScrolled={isScrolled}
      />

      <main>
        <Hero />

        <motion.section
          id="case-studies"
          className="case-studies section-shell"
          variants={animations.fadeUp}
          initial="hidden"
          whileInView="visible"
          viewport={viewport}
        >
          <div className="inner">
            <SectionHeader
              index={1}
              label="Case Studies"
              title="Selected Work"
              description="Production systems I've built or led end-to-end."
            />

            <FilterToolbar
              activeFilter={activeFilter}
              setActiveFilter={setActiveFilter}
              showAll={showAll}
              setShowAll={setShowAll}
              total={filteredStudies.length}
            />

            <motion.div
              className="project-grid"
              variants={animations.stagger}
              initial="hidden"
              whileInView="visible"
              viewport={viewport}
            >
              {visibleStudies.map((study) => (
                <CaseStudyCard key={study.id} study={study} />
              ))}
            </motion.div>
          </div>
        </motion.section>

        <motion.section
          id="architecture"
          className="section-shell"
          variants={animations.fadeUp}
          initial="hidden"
          whileInView="visible"
          viewport={viewport}
        >
          <div className="container">
            <SectionHeader
              index={2}
              label="Architecture"
              title="Systems & Pipeline"
              description="Live operational traces and production architecture."
            />
            <ArchitecturePanel />
          </div>
        </motion.section>

        <CapabilitiesSection />

        <ExperienceSection />

        <PhilosophySection />

        <ContactSection onToast={addToast} />
      </main>

      <footer className="site-footer">
        <div className="inner">
          <div className="left">
            <p className="copyright">© 2026 {profile.name}</p>
            <span className="meta">{footerNote}</span>
          </div>
          <div className="right">
            <a
              href={profile.githubUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="GitHub"
            >
              <Github size={14} className="icon" />
            </a>
            <span className="separator">·</span>
            <a
              href={profile.linkedinUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="LinkedIn"
            >
              <Linkedin size={14} className="icon" />
            </a>
            <span className="separator">·</span>
            <span className="status">Online</span>
          </div>
        </div>
      </footer>

      <ResumeModal
        isOpen={showResumeModal}
        onClose={() => setShowResumeModal(false)}
        onToast={addToast}
      />

      <Toast toasts={toasts} />
    </>
  );
}

export default App;
